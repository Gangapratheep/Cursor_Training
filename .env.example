FLASK_SECRET_KEY=change-me-for-local-demo
ADMIN_PASSWORD=admin123
# Optional: BIND_HOST=127.0.0.1
# Optional: BIND_PORT=5000
# For containers/k8s only: BIND_HOST=0.0.0.0
